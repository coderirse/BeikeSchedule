<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        应用内更新：自有源（明文 HTTP，验签含 APK SHA-256）经 DownloadManager 下载后
        交给系统安装器，需要声明安装请求权限；系统仍会弹出"允许安装"确认。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
        USE_EXACT_ALARM：Android 13+ 安装即自动授予、用户不可撤销，是上课提醒准点触发的关键。
        此前只声明 SCHEDULE_EXACT_ALARM，而 Android 14+ 对 targetSdk 33+ 的应用默认不授予该权限，
        canScheduleExactAlarms() 恒为 false → 退化为非精确闹钟，在国产 ROM 省电管控下被压制到不触发。
        SCHEDULE_EXACT_ALARM 保留作兜底（旧版语义/少数未生效 USE_EXACT_ALARM 的 ROM）。
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BeikeSchedule">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BeikeSchedule"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.caeamer.beikeschedule.action.REMIND" />
                <action android:name="com.caeamer.beikeschedule.action.EXAM_REMIND" />
                <action android:name="com.caeamer.beikeschedule.action.TODO_REMIND" />
                <action android:name="com.caeamer.beikeschedule.action.DAILY_PULSE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!--
                    时间口径变化后必须重排：闹钟按 epoch 毫秒排、计划按本地时间算，
                    跨时区或手动改时间会让已排的提醒整体错点。
                -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 应用内更新：把下载完成的 APK 以 content:// 交给系统安装器（file:// 在 API 24+ 禁用） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
