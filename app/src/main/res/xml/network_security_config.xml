<?xml version="1.0" encoding="utf-8"?>
<!--
    默认全量禁用明文流量（targetSdk 28+ 的默认语义在这里显式写明，便于审计）。
    1.3.8 起全部接口与安装包下载都走 https://api.caeamer.com（Cloudflare Tunnel），
    客户端不再有任何明文 HTTP 通道，因此这里不保留任何 domain-config 例外。
    旧版客户端（≤1.3.7）走 IP 明文那条路由服务端侧保留，与本端无关。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
