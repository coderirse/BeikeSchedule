# 服务端口（Cloudflare Tunnel -> nginx 分流器 -> 本服务）
PORT=3001
BIND_HOST=127.0.0.1

# 与 Reps / showwe 暂共用同一个 JWT_SECRET，保证已有登录态不失效
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# 1 = 所有登录都强制校验教务 jwTicket；0 = 仅允许老客户端走姓名校验
BS_JW_SESSION_REQUIRED=1

# MySQL（与社区、Reps 共用同一个库，仅访问 bs_* 表）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=showwe
DB_PASSWORD=your-password
DB_NAME=showwe
